{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://acordgraph/schemas/extraction.schema.json",
  "title": "AcordGraph LLM Extraction Payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["nodes", "edges", "provenance"],
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "properties"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(PROD|CL|PER)_[A-Za-z0-9_-]{1,64}$"
          },
          "label": {
            "type": "string",
            "enum": ["InsuranceProduct", "Clause", "RiskPeril"]
          },
          "properties": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "product_name":       { "type": "string" },
              "line_of_business":   { "type": "string", "enum": ["L&A", "P&C"] },
              "title":              { "type": "string" },
              "text_content":       { "type": "string" },
              "clause_type":        { "type": "string", "enum": ["Coverage", "Exclusion", "Limit"] },
              "lang":               { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
              "name":               { "type": "string" },
              "icd_code":           { "type": "string", "pattern": "^[A-Z][0-9]{2}(\\.[0-9A-Z]{1,3})?$" },
              "aliases":            { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "target", "type"],
        "properties": {
          "source": { "type": "string" },
          "target": { "type": "string" },
          "type":   { "type": "string", "enum": ["CONTAINS", "COVERS", "EXCLUDES"] },
          "properties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "payout_ratio":        { "type": "number", "minimum": 0, "maximum": 1 },
              "waiting_period_days": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_doc_id", "source_page", "extractor_version", "confidence"],
      "properties": {
        "source_doc_id":     { "type": "string" },
        "source_page":       { "type": "integer", "minimum": 1 },
        "extractor_version": { "type": "string" },
        "confidence":        { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
